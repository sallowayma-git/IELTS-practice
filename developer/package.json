{
  "name": "ielts-practice-developer",
  "version": "0.6.2-fix",
  "description": "Development and testing dependencies for IELTS Practice",
  "private": true,
  "type": "module",
  "devDependencies": {
    "playwright": "^1.56.1"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/js/**/*.test.js\"",
    "test:unit": "node --test --test-concurrency=1 \"tests/js/**/*.test.js\"",
    "test:sync": "node --test --test-concurrency=1 tests/js/folderSyncModel.test.js tests/js/folderSyncPersistence.test.js tests/js/folderSyncRelease.test.js",
