POSTGRES_PASSWORD=replace-with-a-strong-local-postgres-password
DATABASE_URL=postgres://postgres:replace-with-a-strong-local-postgres-password@127.0.0.1:55432/ielts_practice
SESSION_SECRET=replace-with-a-long-random-session-secret

# first-user allows only the first account to self-register.
# Use disabled after creating the account, or open for trusted private networks.
REGISTRATION_MODE=first-user

PORT=3000
HOST=127.0.0.1
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
COOKIE_SECURE=false
TRUST_PROXY=false
TRUSTED_PROXY_IPS=
